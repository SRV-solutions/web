# Ruta backend: una sola pagina (/ruta-backend/inscripcion) vende Master en JavaScript, Backend Avanzado
# o los dos. Las URLs viejas de cada curso van ahi con la opcion preseleccionada.
/javascript/inscripcion            /ruta-backend/inscripcion?elegir=fundamentos-backend   301
/fundamentos-backend/inscripcion   /ruta-backend/inscripcion?elegir=fundamentos-backend   301
/backend-avanzado/inscripcion      /ruta-backend/inscripcion?elegir=backend-avanzado      301
# Gracias vieja de Backend Fundamentos -> la de JavaScript (Netlify conserva el ?payment_id=... de Mercado Pago)
/fundamentos-backend/gracias       /javascript/gracias       301
# Atajos y nombres viejos (los mismos que redirige App.jsx; Netlify conserva lo que venga despues del ?)
/excel            /excel/inscripcion   301
/sql              /sql/inscripcion     301
/base-de-datos    /sql/inscripcion     301
/potrero-it       /el-develop          301
# Funciones de Netlify (API de conversiones de Meta). Tiene que ir antes de la regla final:
# las reglas de este archivo se aplican antes que las de netlify.toml.
/api/*    /.netlify/functions/:splat   200

# Cada pagina tiene su propio HTML en dist (lo escribe scripts/seo-html.mjs al compilar), con su titulo y su
# vista previa: Netlify sirve /sql/inscripcion desde sql/inscripcion.html sin pasar por estas reglas.
# Los certificados llevan un codigo en la URL: todos usan el mismo HTML.
/certificates/*   /certificates.html   200

# Todo lo demas no existe: se muestra la app (React pone "Pagina no encontrada") con estado 404.
# El build se corta si App.jsx tiene una ruta sin HTML ni regla, para que nunca caiga aca una pagina real.
/*    /404.html   404
