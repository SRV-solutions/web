# Ruta backend: una sola pagina (/ruta-backend/inscripcion) vende Master en JavaScript, Backend Avanzado
# o los dos. Las URLs viejas de cada curso van ahi con la opcion preseleccionada.
/javascript/inscripcion            /ruta-backend/inscripcion?elegir=fundamentos-backend   301
/fundamentos-backend/inscripcion   /ruta-backend/inscripcion?elegir=fundamentos-backend   301
/backend-avanzado/inscripcion      /ruta-backend/inscripcion?elegir=backend-avanzado      301
# Gracias vieja de Backend Fundamentos -> la de JavaScript (Netlify conserva el ?payment_id=... de Mercado Pago)
/fundamentos-backend/gracias       /javascript/gracias       301
# El curso de Redes & AWS ya no se vende: su inscripcion vieja (todavia linkeada desde anuncios
# viejos de Meta) va a la home en vez de caer en la pagina de "no encontrado".
/redes/inscripcion                 /                         301

# Funciones de Netlify (API de conversiones de Meta). Tiene que ir antes del SPA:
# las reglas de este archivo se aplican antes que las de netlify.toml.
/api/*    /.netlify/functions/:splat   200

# SPA: todo lo demas lo resuelve React Router
/*    /index.html   200
